@model IReadOnlyList<SmartIMS.Web.ViewModels.CustomerItem>
@{
    ViewData["Title"] = "客戶資料管理";
    ViewData["ToolbarPageCode"] = "PAGE_CUSTOMER_LAYOUT_TEST";
    ViewData["ToolbarActions"] = "create,delete,copy,edit,cancel,find,print,first,previous,next,last";
}

<div class="page-title-row">
    <h1>客戶資料管理</h1>
    <span class="text-muted small">客戶資料已連接資料庫</span>
</div>

<div class="customer-layout-test" data-customer-layout-test
     data-can-create="@(User.HasClaim("smartims.permission", "PAGE_CUSTOMER_LAYOUT_TEST_CREATE") ? "true" : "false")"
     data-can-edit="@(User.HasClaim("smartims.permission", "PAGE_CUSTOMER_LAYOUT_TEST_EDIT") ? "true" : "false")"
     data-save-url="@Url.Action("SaveCustomer", "Home")"
     data-delete-url="@Url.Action("DeleteCustomer", "Home")">
    <div class="win-panel mb-2 customer-detail-panel" data-customer-detail data-mode="empty">
        <div class="section-caption customer-detail-heading">
            <span>客戶明細</span>
            <span class="customer-mode-badge" data-customer-mode aria-live="polite">尚未選取客戶</span>
        </div>
        <p class="customer-mode-hint" data-customer-mode-hint>請點選下方客戶，或按上方「新增」建立新客戶。</p>
        <form id="customerForm" class="compact-form customer-detail-form">
            @Html.AntiForgeryToken()
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label" for="customerCode">客戶編號</label>
                    <input id="customerCode" name="customerCode" class="form-control form-control-sm" maxlength="6" readonly placeholder="存檔後自動產生（C＋5碼）" aria-describedby="customerCodeHelp" />
                    <div id="customerCodeHelp" class="form-text">系統自動編號，例如 C00001。</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="customerName">公司名稱</label>
                    <input id="customerName" name="customerName" maxlength="200" class="form-control form-control-sm" required />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="contact">聯絡人</label>
                    <input id="contact" name="contact" maxlength="100" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="phone">電話</label>
                    <input id="phone" name="phone" maxlength="50" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="fax">傳真</label>
                    <input id="fax" name="fax" maxlength="50" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="email">Email</label>
                    <input id="email" name="email" maxlength="254" class="form-control form-control-sm" type="email" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="line">LINE</label>
                    <input id="line" name="line" maxlength="100" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="taxId">統一編號</label>
                    <input id="taxId" name="taxId" maxlength="20" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="zipCode">郵遞區號</label>
                    <input id="zipCode" name="zipCode" maxlength="20" class="form-control form-control-sm" />
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="deliveryAddress">送貨地址</label>
                    <input id="deliveryAddress" name="deliveryAddress" maxlength="500" class="form-control form-control-sm" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="paymentMethod">預設付款方式</label>
                    <select id="paymentMethod" name="paymentMethod" maxlength="20" class="form-select form-select-sm">
                        <option value="月結">月結</option>
                        <option value="現金">現金</option>
                        <option value="匯款">匯款</option>
                        <option value="票據">票據</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="bankAccount">銀行帳號</label>
                    <input id="bankAccount" name="bankAccount" maxlength="100" class="form-control form-control-sm" />
                </div>
                <div class="col-12">
                    <label class="form-label" for="note">備註</label>
                    <textarea id="note" name="note" maxlength="2000" class="form-control form-control-sm" rows="3"></textarea>
                </div>
            </div>
            <div class="customer-form-actions">
                @if (User.HasClaim("smartims.permission", "PAGE_CUSTOMER_LAYOUT_TEST_CREATE") || User.HasClaim("smartims.permission", "PAGE_CUSTOMER_LAYOUT_TEST_EDIT"))
                {
                    <button type="submit" class="btn btn-sm btn-primary" data-customer-save disabled>存檔</button>
                }
                <button type="button" class="btn btn-sm btn-outline-secondary" data-customer-cancel disabled>取消</button>
                <span class="customer-form-status" data-customer-form-status role="status" aria-live="polite"></span>
            </div>
        </form>
    </div>

    <div class="win-panel">
        <div class="section-caption">客戶清單</div>
        <div class="customer-list-tools">
            <input id="customerSearch" class="form-control form-control-sm" type="search" placeholder="輸入客戶編號、公司名稱、聯絡人、電話、統一編號或地址尋找" />
            <span class="customer-layout-status" data-customer-status></span>
        </div>
        <div class="listview-frame customer-list-frame">
            <table class="listview-table customer-list-table">
                <thead>
                    <tr>
                        <th style="width: 100px;">客戶編號</th>
                        <th style="width: 150px;">公司名稱</th>
                        <th style="width: 130px;">聯絡人</th>
                        <th style="width: 130px;">電話</th>
                        <th style="width: 130px;">Email</th>
                        <th style="width: 120px;">LINE</th>
                        <th style="width: 120px;">統一編號</th>
                        <th style="width: 220px;">送貨地址</th>
                        <th style="width: 130px;">預設付款方式</th>
                    </tr>
                </thead>
                <tbody id="customerRows"></tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script type="application/json" id="customerData">@Json.Serialize(Model)</script>
    <script src="~/js/customer-management.js" asp-append-version="true"></script>
}
